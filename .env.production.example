APP_NAME=Getingo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://getingo.hu
FRONTEND_URL=https://getingo.hu

APP_LOCALE=hu
APP_FALLBACK_LOCALE=hu

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=getingo.hu,www.getingo.hu
CORS_ALLOWED_ORIGINS=https://getingo.hu,https://www.getingo.hu
TRUSTED_HOSTS=^getingo\.hu$,^www\.getingo\.hu$
# Csak akkor töltsd ki, ha a tárhelyed dokumentált reverse proxyt használ.
# Ne állítsd * értékre.
TRUSTED_PROXIES=
MAX_REQUEST_BYTES=1048576
AUDIT_LOG_RETENTION_DAYS=90

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Getingo"

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=

PRIVACY_POLICY_VERSION=2026-10-01

# Sandboxed code execution for Python, C# and SQL
CODE_RUNNER_PYTHON_PROVIDER=judge0
CODE_RUNNER_CSHARP_PROVIDER=onecompiler
CODE_RUNNER_SQL_PROVIDER=onecompiler
CODE_RUNNER_FALLBACK_PROVIDER=judge0
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
ONECOMPILER_URL=https://api.onecompiler.com/v1
ONECOMPILER_API_KEY=
PISTON_URL=
PISTON_AUTH_HEADER=Authorization
PISTON_AUTH_TOKEN=
