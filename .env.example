APP_NAME=Getingo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4200

APP_LOCALE=hu
APP_FALLBACK_LOCALE=hu
APP_FAKER_LOCALE=hu_HU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost:4200,127.0.0.1:4200

# Browser / proxy hardening
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://getingo.hu,https://www.getingo.hu
TRUSTED_HOSTS=^localhost$,^127\.0\.0\.1$,^(.+\.)?getingo\.hu$
# Csak akkor töltsd ki, ha a tárhelyed dokumentált reverse proxy címet használ.
TRUSTED_PROXIES=
MAX_REQUEST_BYTES=1048576
AUDIT_LOG_RETENTION_DAYS=90

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Getingo privacy policy version stored with each registration acceptance
PRIVACY_POLICY_VERSION=2026-09-30

# Stripe Premium subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_YEARLY_PRICE_ID=

# Sandboxed code execution for Python, C# and SQL
# Primary providers: judge0, onecompiler or piston
CODE_RUNNER_PYTHON_PROVIDER=judge0
CODE_RUNNER_CSHARP_PROVIDER=onecompiler
CODE_RUNNER_SQL_PROVIDER=onecompiler
CODE_RUNNER_FALLBACK_PROVIDER=judge0

# Judge0 fallback (works without an API key on compatible public/self-hosted instances)
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=

# OneCompiler hosted API. Hosted C# and MySQL-compatible SQL sandbox.
ONECOMPILER_URL=https://api.onecompiler.com/v1
ONECOMPILER_API_KEY=

# Optional self-hosted Piston. Point this to the /api/v2 base, e.g. https://runner.example.com/api/v2
PISTON_URL=
PISTON_AUTH_HEADER=Authorization
PISTON_AUTH_TOKEN=
