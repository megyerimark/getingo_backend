server {
    listen 443 ssl http2;
    server_name api.example.com;

    root /var/www/getingo/public;
    index index.php;

    # A Laravel oldali MAX_REQUEST_BYTES értékkel legyen összhangban.
    client_max_body_size 1m;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 15s;
    send_timeout 15s;

    limit_conn getingo_conn 30;
    limit_req zone=getingo_general burst=40 nodelay;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location = /api/bejelentkezes {
        limit_req zone=getingo_auth burst=5 nodelay;
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /api/regisztracio {
        limit_req zone=getingo_auth burst=3 nodelay;
        try_files $uri $uri/ /index.php?$query_string;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_read_timeout 30s;
    }

    location ~ /\. {
        deny all;
    }
}
